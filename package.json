{
  "name": "emotion-ball-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "基于 Emotion Ball 表情引擎的桌面宠物",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "hooks": "node tools/setup-hooks.mjs",
    "hooks:install": "node tools/setup-hooks.mjs install",
    "hooks:remove": "node tools/setup-hooks.mjs remove",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "pack": "electron-builder --dir"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3"
  },
  "productName": "Emotion Ball",
  "author": "the-wayee",
  "build": {
    "appId": "com.thewayee.emotionball",
    "productName": "Emotion Ball",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "main.js",
      "preload.js",
      "preload-settings.js",
      "settings.js",
      "activity.js",
      "deepseek.js",
      "integrations.js",
      "reactions.js",
      "platform/**/*",
      "renderer/**/*",
      "vendor/**/*",
      "assets/**/*",
      "!**/*.map",
      "!**/.DS_Store"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "extendInfo": {
        "LSUIElement": true
      },
      "icon": "assets/icon.icns"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon-256.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    }
  }
}
